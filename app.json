{
  "expo": {
    "name": "HomeAssistantExpo",
    "slug": "home-assistant",
    "version": "1.3.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "homeassistantexpo",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#000000",
    "android": {
      "package": "com.thavixt.homeassistant",
      "adaptiveIcon": {
        "backgroundColor": "#18BCF2",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#030712",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-status-bar",
      "expo-sqlite",
      [
        "expo-sensors",
        {
          "motionPermission": "Allow $(PRODUCT_NAME) to use motion sensors to point at your devices"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "04316844-cc0e-4a78-ab4f-9c5bbe8dcc25"
      }
    },
    "owner": "thavixt"
  }
}
